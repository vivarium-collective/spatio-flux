{
  "global_time": 0.0,
  "dFBA": {
    "address": {
      "protocol": "local",
      "data": "DynamicFBA"
    },
    "config": {
      "model_file": "textbook",
      "kinetic_params": {
        "glucose": [
          0.5,
          1.0
        ],
        "acetate": [
          0.5,
          2.0
        ]
      },
      "substrate_update_reactions": {
        "glucose": "EX_glc__D_e",
        "acetate": "EX_ac_e"
      },
      "bounds": {
        "EX_o2_e": {
          "lower": -2.0,
          "upper": null
        },
        "ATPM": {
          "lower": 1.0,
          "upper": 1.0
        }
      },
      "solver": null,
      "box_volume_L": 1.0
    },
    "_inputs": "substrates:map[concentration]|biomass:mass",
    "_outputs": "substrates:map[concentration_delta]|biomass:mass_delta",
    "inputs": {
      "substrates": {
        "glucose": [
          "fields",
          "glucose"
        ],
        "acetate": [
          "fields",
          "acetate"
        ]
      },
      "biomass": [
        "fields",
        "dfba biomass"
      ]
    },
    "outputs": {
      "substrates": {
        "glucose": [
          "fields",
          "glucose"
        ],
        "acetate": [
          "fields",
          "acetate"
        ]
      },
      "biomass": [
        "fields",
        "dfba biomass"
      ]
    },
    "interval": 1.0,
    "_contract": {
      "summary": "Dynamic FBA \u2014 FBA growth integrated over time",
      "description": "",
      "inputs": {},
      "outputs": {},
      "config": {},
      "math": [
        "\\mu=\\max\\ c^{\\mathsf T}v\\quad\\text{s.t.}\\ \\ Sv=0,\\ \\ v\\le v_{\\max}(s)",
        "\\dot X=\\mu X,\\qquad \\dot s=-q(s)\\,X"
      ],
      "symbols": {
        "\u03bc": "growth rate",
        "v": "reaction fluxes",
        "S": "stoichiometry",
        "X": "biomass",
        "s": "substrate",
        "q": "uptake rate"
      },
      "assumptions": [],
      "references": [],
      "face": {
        "inputs": {
          "substrates": {
            "_type": "map",
            "_value": {
              "_type": "concentration",
              "_units": "mM"
            }
          },
          "biomass": {
            "_type": "mass",
            "_units": "gDW"
          }
        },
        "outputs": {
          "substrates": "map[concentration_delta]",
          "biomass": "mass_delta"
        }
      },
      "amendments": []
    }
  },
  "monod_kinetics": {
    "address": {
      "protocol": "local",
      "data": "MonodKinetics"
    },
    "config": {
      "reactions": {
        "assimilate_acetate": {
          "reactant": "acetate",
          "product": "mass",
          "km": 0.6,
          "vmax": 0.3,
          "yield": 0.2
        }
      }
    },
    "_inputs": "biomass:mass|substrates:map[concentration]",
    "_outputs": "biomass:mass_delta|substrates:map[concentration_delta]",
    "inputs": {
      "substrates": {
        "acetate": [
          "fields",
          "acetate"
        ]
      },
      "biomass": [
        "fields",
        "kinetic biomass"
      ]
    },
    "outputs": {
      "substrates": {
        "acetate": [
          "fields",
          "acetate"
        ]
      },
      "biomass": [
        "fields",
        "kinetic biomass"
      ]
    },
    "interval": 1.0,
    "_contract": {
      "summary": "Monod kinetics \u2014 substrate-saturating growth",
      "description": "",
      "inputs": {},
      "outputs": {},
      "config": {},
      "math": [
        "\\mu=\\mu_{\\max}\\,\\frac{s}{K_s+s},\\qquad \\dot X=\\mu X,\\ \\ \\dot s=-\\mu X/Y"
      ],
      "symbols": {
        "\u03bc_max": "max growth rate",
        "K_s": "half-saturation const",
        "Y": "biomass yield"
      },
      "assumptions": [],
      "references": [],
      "face": {
        "inputs": {
          "biomass": {
            "_type": "mass",
            "_units": "gDW"
          },
          "substrates": {
            "_type": "map",
            "_value": {
              "_type": "concentration",
              "_units": "mM"
            }
          }
        },
        "outputs": {
          "biomass": "mass_delta",
          "substrates": "map[concentration_delta]"
        }
      },
      "amendments": []
    }
  },
  "fields": {
    "glucose": 10.0,
    "acetate": 0.0,
    "dfba biomass": 0.01,
    "kinetic biomass": 0.01
  },
  "emitter": {
    "address": {
      "protocol": "local",
      "data": "RAMEmitter"
    },
    "config": {
      "emit": "global_time:node|fields:node",
      "subsample": 1
    },
    "_inputs": "global_time:node|fields:node",
    "_outputs": "results:node",
    "inputs": {
      "global_time": [
        "global_time"
      ],
      "fields": [
        "fields"
      ]
    },
    "outputs": {
      "results": [
        "results"
      ]
    },
    "_contract": {
      "summary": "Store historical states in memory.",
      "description": "every tick). Use this for long runs or composites with heavy\nstate (large fields, many agents) to keep RAM bounded \u2014 the\nsaved time-series still reflects the simulation's true cadence\nvia each row's ``global_time`` field.",
      "inputs": {},
      "outputs": {},
      "config": {},
      "math": [
        "``subsample`` records only every Nth composite tick (default 1 ="
      ],
      "symbols": {},
      "assumptions": [],
      "references": [],
      "face": {
        "inputs": {
          "global_time": "node",
          "fields": "node"
        },
        "outputs": {
          "results": "node"
        }
      },
      "amendments": []
    }
  },
  "results": {}
}
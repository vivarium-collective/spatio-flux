{
  "global_time": 0.0,
  "monod_kinetics": {
    "address": {
      "protocol": "local",
      "data": "MonodKinetics"
    },
    "config": {
      "reactions": {
        "assimilate_glucose": {
          "reactant": "glucose",
          "product": "mass",
          "km": 0.5,
          "vmax": 0.4,
          "yield": 0.2
        },
        "overflow_to_acetate": {
          "reactant": "glucose",
          "product": "acetate",
          "km": 0.5,
          "vmax": 0.3,
          "yield": 0.5
        },
        "assimilate_acetate": {
          "reactant": "acetate",
          "product": "mass",
          "km": 0.6,
          "vmax": 0.3,
          "yield": 0.2
        }
      }
    },
    "_inputs": "biomass:mass|substrates:map[concentration]",
    "_outputs": "biomass:mass_delta|substrates:map[concentration_delta]",
    "inputs": {
      "substrates": {
        "acetate": [
          "fields",
          "acetate"
        ],
        "glucose": [
          "fields",
          "glucose"
        ]
      },
      "biomass": [
        "fields",
        "biomass"
      ]
    },
    "outputs": {
      "substrates": {
        "acetate": [
          "fields",
          "acetate"
        ],
        "glucose": [
          "fields",
          "glucose"
        ]
      },
      "biomass": [
        "fields",
        "biomass"
      ]
    },
    "interval": 0.1,
    "_contract": {
      "summary": "Monod kinetics \u2014 substrate-saturating growth",
      "description": "",
      "inputs": {},
      "outputs": {},
      "config": {},
      "math": [
        "\\mu=\\mu_{\\max}\\,\\frac{s}{K_s+s},\\qquad \\dot X=\\mu X,\\ \\ \\dot s=-\\mu X/Y"
      ],
      "symbols": {
        "\u03bc_max": "max growth rate",
        "K_s": "half-saturation const",
        "Y": "biomass yield"
      },
      "assumptions": [],
      "references": [],
      "face": {
        "inputs": {
          "biomass": {
            "_type": "mass",
            "_units": "gDW"
          },
          "substrates": {
            "_type": "map",
            "_value": {
              "_type": "concentration",
              "_units": "mM"
            }
          }
        },
        "outputs": {
          "biomass": "mass_delta",
          "substrates": "map[concentration_delta]"
        }
      },
      "amendments": []
    }
  },
  "fields": {
    "glucose": 10.0,
    "acetate": 0.0,
    "biomass": 0.1
  },
  "emitter": {
    "address": {
      "protocol": "local",
      "data": "RAMEmitter"
    },
    "config": {
      "emit": "global_time:node|fields:node",
      "subsample": 1
    },
    "_inputs": "global_time:node|fields:node",
    "_outputs": "results:node",
    "inputs": {
      "global_time": [
        "global_time"
      ],
      "fields": [
        "fields"
      ]
    },
    "outputs": {
      "results": [
        "results"
      ]
    },
    "_contract": {
      "summary": "Store historical states in memory.",
      "description": "every tick). Use this for long runs or composites with heavy\nstate (large fields, many agents) to keep RAM bounded \u2014 the\nsaved time-series still reflects the simulation's true cadence\nvia each row's ``global_time`` field.",
      "inputs": {},
      "outputs": {},
      "config": {},
      "math": [
        "``subsample`` records only every Nth composite tick (default 1 ="
      ],
      "symbols": {},
      "assumptions": [],
      "references": [],
      "face": {
        "inputs": {
          "global_time": "node",
          "fields": "node"
        },
        "outputs": {
          "results": "node"
        }
      },
      "amendments": []
    }
  },
  "results": {}
}
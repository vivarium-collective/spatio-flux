{
  "global_time": "float",
  "particles": "map[id:string|position:tuple[set_float,set_float]|mass:mass|local:map[concentration]|exchange:map[count]|sub_masses:map[mass]]",
  "brownian_movement": {
    "_type": "process",
    "address": "local:BrownianMovement",
    "config": "node",
    "_inputs": "particles:map[id:string|position:tuple[set_float,set_float]|mass:mass|local:map[concentration]|exchange:map[count]|sub_masses:map[mass]]",
    "_outputs": "particles:map[id:string|position:tuple[set_float,set_float]|mass:mass|local:map[concentration]|exchange:map[count]|sub_masses:map[mass]]",
    "inputs": "wires",
    "outputs": "wires",
    "interval": 0.1
  },
  "enforce_boundaries": {
    "_type": "step",
    "address": "local:ManageBoundaries",
    "config": "node",
    "_inputs": "particles:map[id:string|position:tuple[set_float,set_float]|mass:mass|local:map[concentration]|exchange:map[count]|sub_masses:map[mass]]|process_interval:float",
    "_outputs": "particles:map[id:string|position:tuple[set_float,set_float]|mass:mass|local:map[concentration]|exchange:map[count]|sub_masses:map[mass]]",
    "inputs": "wires",
    "outputs": "wires",
    "priority": 0.0
  },
  "emitter": {
    "_type": "step",
    "address": "local:RAMEmitter",
    "config": "node",
    "_inputs": "global_time:node|particles:node",
    "_outputs": "results:node",
    "inputs": "wires",
    "outputs": "wires",
    "priority": 0.0
  },
  "results": "node"
}
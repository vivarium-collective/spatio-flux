        "inputs": "wires",
        "outputs": "wires",
        "interval": 1.0
      },
      "id": "string",
      "position": "tuple[set_float,set_float]",
      "mass": "mass",
      "local": "map[concentration]",
      "exchange": "map[count]",
      "sub_masses": "map[mass]",
      "shape": "enum[circle,segment]",
      "velocity": "tuple[set_float,set_float]",
      "inertia": "set_float",
      "friction": "set_float",
      "elasticity": "set_float",
      "radius": "set_float"
    }
  },
  "global_time": "float",
  "fields": "map[positive_array]",
  "spatial_dFBA": {
    "_type": "process",
    "address": "local:SpatialDFBA",
    "config": "node",
    "_inputs": "fields:map[positive_array]|biomass:array[10|10,float]",
    "_outputs": "fields:map[array[10|10,float]]|biomass:array[10|10,float]",
    "inputs": "wires",
    "outputs": "wires",
    "interval": 1.0
  },
  "diffusion": {
    "_type": "process",
    "address": "local:DiffusionAdvection",
    "config": "node",
    "_inputs": "fields:map[positive_array]",

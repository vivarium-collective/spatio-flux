{
  "ecoli dFBA": {
    "_type": "process",
    "address": "local:DynamicFBA",
    "config": {
      "model_file": "iAF1260.xml",
      "substrate_update_reactions": {
        "glucose": "EX_glc__D_e",
        "formate": "EX_for_e"
      },
      "kinetic_params": {
        "glucose": [
          0.5,
          1
        ],
        "formate": [
          0.5,
          2
        ]
      }
    },
    "inputs": {
      "substrates": {
        "glucose": [
          "fields",
          "glucose"
        ],
        "formate": [
          "fields",
          "formate"
        ]
      },
      "biomass": [
        "fields",
        "biomass"
      ]
    },
    "outputs": {
      "substrates": {
        "glucose": [
          "fields",
          "glucose"
        ],
        "formate": [
          "fields",
          "formate"
        ]
      },
      "biomass": [
        "fields",
        "biomass"
      ]
    },
    "interval": 1.0
  },
  "fields": {
    "glucose": 10.0,
    "formate": 5.0,
    "biomass": 0.1
  },
  "viz_biomass": {
    "_type": "step",
    "address": "local:DemoTimeSeriesPlot",
    "config": {
      "title": "biomass over time"
    },
    "inputs": {
      "value": [
        "fields",
        "biomass"
      ]
    },
    "outputs": {
      "html": [
        "viz_biomass_html"
      ]
    }
  },
  "viz_biomass_html": ""
}
    "inputs": {
      "acetate": [
        "fields",
        "acetate"
      ],
      "biomass": [
        "fields",
        "biomass"
      ],
      "glucose": [
        "fields",
        "glucose"
      ]
    },
    "outputs": {
      "html": [
        "viz_timeseries_html"
      ]
    }
  },
  "viz_timeseries_html": ""

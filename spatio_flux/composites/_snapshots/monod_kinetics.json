{
  "monod_kinetics": {
    "_type": "process",
    "address": "local:MonodKinetics",
    "config": {
      "reactions": {
        "assimilate_glucose": {
          "reactant": "glucose",
          "product": "mass",
          "km": 0.5,
          "vmax": 0.4,
          "yield": 0.2
        },
        "overflow_to_acetate": {
          "reactant": "glucose",
          "product": "acetate",
          "km": 0.5,
          "vmax": 0.3,
          "yield": 0.5
        },
        "assimilate_acetate": {
          "reactant": "acetate",
          "product": "mass",
          "km": 0.6,
          "vmax": 0.3,
          "yield": 0.2
        }
      }
    },
    "inputs": {
      "substrates": {
        "acetate": [
          "fields",
          "acetate"
        ],
        "glucose": [
          "fields",
          "glucose"
        ]
      },
      "biomass": [
        "fields",
        "biomass"
      ]
    },
    "outputs": {
      "substrates": {
        "acetate": [
          "fields",
          "acetate"
        ],
        "glucose": [
          "fields",
          "glucose"
        ]
      },
      "biomass": [
        "fields",
        "biomass"
      ]
    },
    "interval": 0.1
  },
  "fields": {
    "glucose": 10.0,
    "acetate": 0.0,
    "biomass": 0.1
  },
  "viz_biomass": {
    "_type": "step",
    "address": "local:DemoTimeSeriesPlot",
    "config": {
      "title": "biomass over time"
    },
    "inputs": {
      "value": [
        "fields",
        "biomass"
      ]
    },
    "outputs": {
      "html": [
        "viz_biomass_html"
      ]
    }
  },
  "viz_biomass_html": ""
}
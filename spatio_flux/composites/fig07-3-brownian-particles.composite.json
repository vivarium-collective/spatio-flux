        "diffusion_rate": 0.5,
        "advection_rate": [
          0,
          0
        ],
        "interval": 0.1
      },
      "inputs": {
        "particles": [
          "particles"
        ]
      },
      "outputs": {
        "particles": [
          "particles"
        ]
      },
      "interval": 0.1

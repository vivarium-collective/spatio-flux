      "interval": 0.1,
      "_contract": {
        "summary": "Brownian motion \u2014 overdamped diffusive steps",
        "description": "Brownian motion \u2014 overdamped diffusive steps",
        "status": "",
        "math": [
          "\\Delta x=\\sqrt{2D\\,\\Delta t}\\;\\xi\\;+\\;\\mathbf{u}\\,\\Delta t,\\qquad \\xi\\sim\\mathcal{N}(0,1)"
        ],
        "symbols": {
          "D": "diffusion coefficient",
          "\u0394t": "time step",
          "u": "advection velocity",
          "\u03be": "unit Gaussian noise"
        },
        "inputs": {},
        "outputs": {}
      }
    },
    "enforce_boundaries": {
      "_type": "step",
      "address": "local:ManageBoundaries",
      "config": {
        "bounds": [
          50.0,
          50.0
        ],
        "add_rate": 0.01,
        "boundary_to_add": [
          "top",
          "bottom",
          "left",
          "right"
        ],
        "boundary_to_remove": [],
        "clamp_survivors": true,
        "buffer": 0.0001,
        "mass_range": [
          0.001,
          1.0
        ]
      },
      "inputs": {
        "particles": [
          "particles"
        ],
        "process_interval": [

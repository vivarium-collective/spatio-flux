          "interval"
        ]
      },
      "outputs": {
        "particles": [
          "particles"
        ]
      },
      "_contract": {
        "summary": "Keep particles inside the domain (inflow/outflow)",
        "description": "Keep particles inside the domain (inflow/outflow)",
        "status": "",
        "math": [
          "x \\;\\leftarrow\\; \\operatorname{clamp}(x,\\ 0,\\ L)"
        ],
        "symbols": {
          "x": "particle position",
          "L": "domain size"
        },
        "inputs": {},
        "outputs": {}
      }
